const int RED_PIN = 9;
const int GREEN_PIN = 10;
const int BLUE_PIN = 11;

const bool COMMON_ANODE = false;

const unsigned long CYCLE_TIME = 10000;

void setColor(int red, int green, int blue) {
  if (COMMON_ANODE) {
    red = 255 - red;
    green = 255 - green;
    blue = 255 - blue;
  }

  analogWrite(RED_PIN, red);
  analogWrite(GREEN_PIN, green);
  analogWrite(BLUE_PIN, blue);
}

void setup() {
  pinMode(RED_PIN, OUTPUT);
  pinMode(GREEN_PIN, OUTPUT);
  pinMode(BLUE_PIN, OUTPUT);

  setColor(255, 0, 0);
}

void loop() {
  unsigned long currentTime = millis();

  float position = (currentTime % CYCLE_TIME) / (float)CYCLE_TIME;

  float segment = position * 6.0;

  int section = (int)segment;
  float progress = segment - section;

  int red;
  int green;
  int blue;

  switch (section) {
    case 0:
      red = 255;
      green = progress * 255;
      blue = 0;
      break;

    case 1:
      red = (1.0 - progress) * 255;
      green = 255;
      blue = 0;
      break;

    case 2:
      red = 0;
      green = 255;
      blue = progress * 255;
      break;

    case 3:
      red = 0;
      green = (1.0 - progress) * 255;
      blue = 255;
      break;

    case 4:
      red = progress * 255;
      green = 0;
      blue = 255;
      break;

    default:
      red = 255;
      green = 0;
      blue = (1.0 - progress) * 255;
      break;
  }

  setColor(red, green, blue);
}
