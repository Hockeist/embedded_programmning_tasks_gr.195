const int RED_LED = 8;
const int YELLOW_LED = 9;
const int GREEN_LED = 10;

const unsigned long GREEN_TIME = 5000;
const unsigned long GREEN_BLINK_TIME = 500;
const unsigned long YELLOW_TIME = 2000;
const unsigned long RED_TIME = 5000;
const unsigned long RED_YELLOW_TIME = 2000;

const int GREEN_BLINKS = 3;

void setup() {
  pinMode(RED_LED, OUTPUT);
  pinMode(YELLOW_LED, OUTPUT);
  pinMode(GREEN_LED, OUTPUT);
}

void loop() {
  digitalWrite(GREEN_LED, HIGH);
  digitalWrite(YELLOW_LED, LOW);
  digitalWrite(RED_LED, LOW);

  delay(GREEN_TIME);
  
  for (int i = 0; i < GREEN_BLINKS; i++) {
    digitalWrite(GREEN_LED, LOW);
    delay(GREEN_BLINK_TIME);

    digitalWrite(GREEN_LED, HIGH);
    delay(GREEN_BLINK_TIME);
  }

  digitalWrite(GREEN_LED, LOW);

  digitalWrite(YELLOW_LED, HIGH);
  delay(YELLOW_TIME);

  digitalWrite(YELLOW_LED, LOW);
  digitalWrite(RED_LED, HIGH);

  delay(RED_TIME);

  digitalWrite(YELLOW_LED, HIGH);

  delay(RED_YELLOW_TIME);

  digitalWrite(RED_LED, LOW);
  digitalWrite(YELLOW_LED, LOW);
